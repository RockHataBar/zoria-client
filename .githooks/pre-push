#!/bin/sh
zero=0000000000000000000000000000000000000000
gl=$(command -v gitleaks 2>/dev/null || command -v gitleaks.exe 2>/dev/null)
if [ -z "$gl" ]; then
  for c in "$HOME/AppData/Local/Microsoft/WinGet/Links/gitleaks.exe" "$HOME"/AppData/Local/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe /usr/local/bin/gitleaks /opt/homebrew/bin/gitleaks; do
    if [ -x "$c" ]; then
      gl=$c
      break
    fi
  done
fi
if [ -z "$gl" ]; then
  echo "pre-push: gitleaks не знайдено, пуш зупинено (winget install Gitleaks.Gitleaks)" >&2
  exit 1
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  "$gl" git --no-banner --redact --log-opts="$range" . || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: gitleaks знайшов можливий секрет, пуш зупинено" >&2
fi
exit "$status"
